generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 ADMIN
 EDITOR
 VIEWER
}
enum Status {
 DRAFT
 PUBLISHED
 ARCHIVED
}
model User {
 id String @id @default(uuid())
 email String @unique
 name String
 passwordHash String
 role Role @default(EDITOR)
 active Boolean @default(true)
 tokenVersion Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Content {
 id String @id @default(uuid())
 kind String
 title String
 slug String
 status Status @default(DRAFT)
 excerpt String?
 content Json @default("{}")
 metadata Json @default("{}")
 /// F-003: SQL scheduling columns, kept in sync with metadata by the content_schedule_sync trigger
 /// (migration 20261109000000) and by the admin write path. Public eligibility filters on these.
 publishAt DateTime?
 startsAt DateTime?
 endsAt DateTime?
 enabled Boolean @default(true)
 requiresReview Boolean @default(false)
 sortOrder Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([kind, slug])
 @@index([kind, status, sortOrder, createdAt(sort: Desc)])
 @@index([kind, status, publishAt])
}
model Media {
 id String @id @default(uuid())
 filename String
 originalName String
 mimeType String
 size Int
 alt String @default("")
 url String
 createdAt DateTime @default(now())
}
model Inquiry {
 id String @id @default(uuid())
 name String
 email String
 phone String?
 service String?
 message String
 status String @default("NEW")
 emailStatus String @default("NOT_CONFIGURED")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status, createdAt(sort: Desc)])
}
model PopupEvent {
 id String @id @default(uuid())
 popupId String
 event String
 sessionId String?
 createdAt DateTime @default(now())
 @@index([popupId, event])
 @@index([createdAt(sort: Desc)])
}
model Audit {
 id String @id @default(uuid())
 actorId String?
 action String
 resource String
 resourceId String?
 createdAt DateTime @default(now())
 @@index([createdAt])
}
enum BookingStatus {
 PENDING
 CONFIRMED
 CANCELLED
 COMPLETED
 REFUNDED
}
model Booking {
 id String @id @default(uuid())
 serviceType String
 serviceId String?
 serviceName String
 customerName String
 customerEmail String
 customerPhone String?
 bookingDate String?
 bookingTime String?
 duration Int?
 guests Int @default(1)
 addOns Json @default("[]")
 notes String?
 couponCode String?
 couponDiscount Float @default(0)
 subtotalPrice Float
 totalPrice Float
 /// F-014: expand-only integer cents mirror; the Float columns stay authoritative in this release.
 subtotalPriceCents Int?
 totalPriceCents Int?
 stripePaymentIntentId String?
 stripeChargeId String?
 stripeResponse Json?
 emailStatus String @default("NOT_CONFIGURED")
 status BookingStatus @default(PENDING)
 /// Set only by a verified claim from an activated account; never inferred from customerEmail.
 customerId String?
 claimedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([serviceType, status])
 @@index([customerEmail])
 @@index([customerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing: catalog plans, orders/checkout attempts, Stripe subscriptions,
// invoices, entitlement ledger, webhook journal and billing audit trail.
// Additive only. Existing Booking/Inquiry/Content rows are untouched.
// ─────────────────────────────────────────────────────────────────────────────
enum BillingType {
 ONE_TIME
 RECURRING
}
enum BillingInterval {
 MONTH
 YEAR
}
enum PricingUnit {
 PACKAGE
 HOUR
 DAY
 SEAT
 ITEM
 SESSION
}
enum OrderStatus {
 PENDING
 PAID
 PARTIALLY_PAID
 FAILED
 EXPIRED
 CANCELLED
}
enum AccessStatus {
 PENDING
 ACTIVE
 PAST_DUE
 SUSPENDED
 ENDED
}
enum EntitlementKind {
 COWORKING_DAY
 MEETING_ROOM_HOUR
 STUDIO_HOUR
 CREDIT
}
enum WebhookStatus {
 PENDING
 PROCESSED
 FAILED
 IGNORED
}
model Plan {
 id String @id @default(uuid())
 slug String @unique
 name String
 serviceType String
 description String @default("")
 billingType BillingType @default(ONE_TIME)
 interval BillingInterval?
 intervalCount Int @default(1)
 unitAmount Int
 currency String @default("usd")
 pricingUnit PricingUnit @default(PACKAGE)
 durationMinutes Int?
 minQuantity Int @default(1)
 maxQuantity Int @default(1)
 requiresSchedule Boolean @default(false)
 requiresResource Boolean @default(false)
 requiresOnboarding Boolean @default(false)
 trialDays Int @default(0)
 includedCredits Json @default("[]")
 metadata Json @default("{}")
 active Boolean @default(true)
 archivedAt DateTime?
 sortOrder Int @default(0)
 stripeProductId String?
 stripePriceId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 orderItems OrderItem[]
 subscriptions Subscription[]
 @@index([serviceType, active])
}
/// Customer identity and primary billing profile.
/// - email is the address as entered (lower-cased); it is NOT unique on its own.
/// - emailKey is the login identity: lower(email) for exactly one primary row per
///   address, NULL for shadow rows (unverified guest purchases made with the email
///   of an already-activated account, awaiting a verified claim) and for rows that
///   lost a case-insensitive collision during migration 20261111000000.
/// - A customer is never a staff User: there is no role column and no shared guard.
model Customer {
 id String @id @default(uuid())
 email String
 emailKey String? @unique
 name String @default("")
 phone String?
 company String?
 billingAddress Json?
 stripeCustomerId String? @unique
 metadata Json @default("{}")
 accountStatus CustomerAccountStatus @default(GUEST)
 /// NULL for a primary row; PENDING_CLAIM | CLAIMED | DECLINED | COLLISION otherwise.
 shadowState String?
 mergedIntoId String?
 mergedInto Customer? @relation("CustomerClaims", fields: [mergedIntoId], references: [id])
 claimedProfiles Customer[] @relation("CustomerClaims")
 passwordHash String?
 passwordChangedAt DateTime?
 emailVerifiedAt DateTime?
 pendingEmail String?
 failedLoginCount Int @default(0)
 lockedUntil DateTime?
 lastLoginAt DateTime?
 accountTermsVersion String?
 accountTermsAcceptedAt DateTime?
 cardConsentAt DateTime?
 marketingOptIn Boolean @default(false)
 marketingConsentAt DateTime?
 notificationPrefs Json @default("{}")
 /// OK | MISSING | EXPIRED | UNKNOWN: last reconciled state of the minimum-one-card invariant.
 cardStatus String @default("UNKNOWN")
 cardCheckedAt DateTime?
 closureRequestedAt DateTime?
 /// Lease-based mutex serialising card/subscription mutations across instances.
 mutationLockToken String?
 mutationLockUntil DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 orders Order[]
 subscriptions Subscription[]
 entitlements EntitlementEntry[]
 invoices Invoice[]
 sessions CustomerSession[]
 tokens CustomerToken[]
 cards CustomerCard[]
 @@index([email])
 @@index([mergedIntoId])
}
enum CustomerAccountStatus {
 GUEST
 PENDING_SETUP
 ACTIVE
}
/// Opaque server-side session. Only sha256(token) is stored; the token itself
/// lives in an HttpOnly cookie scoped to /api.
model CustomerSession {
 id String @id @default(uuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 tokenHash String @unique
 /// PASSWORD sessions may perform sensitive changes; LINK sessions must reauthenticate.
 method String @default("PASSWORD")
 userAgent String?
 ipHint String?
 createdAt DateTime @default(now())
 lastSeenAt DateTime @default(now())
 reauthAt DateTime?
 expiresAt DateTime
 revokedAt DateTime?
 @@index([customerId, revokedAt])
}
/// Single-use, purpose-bound token. Only the hash is stored.
model CustomerToken {
 id String @id @default(uuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 /// ACCOUNT_SETUP | PASSWORD_RESET | EMAIL_CHANGE | LOGIN_LINK
 purpose String
 tokenHash String @unique
 data Json @default("{}")
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 @@index([customerId, purpose])
}
/// Transactional outbox. The body is rendered at delivery time, so no secret
/// link or token is ever stored here; retries mint a fresh single-use token.
model EmailOutbox {
 id String @id @default(uuid())
 customerId String?
 toEmail String
 template String
 payload Json @default("{}")
 dedupeKey String? @unique
 /// PENDING | SENDING | SENT | FAILED (retryable) | DEAD
 status String @default("PENDING")
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 lockedUntil DateTime?
 lastError String?
 sentAt DateTime?
 createdAt DateTime @default(now())
 @@index([status, nextAttemptAt])
 @@index([customerId])
}
/// Mirror of Stripe card metadata. Stripe stays authoritative; this never holds PAN/CVC.
model CustomerCard {
 id String @id @default(uuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
 stripePaymentMethodId String @unique
 brand String @default("card")
 last4 String @default("")
 expMonth Int @default(0)
 expYear Int @default(0)
 isDefault Boolean @default(false)
 detachedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([customerId, detachedAt])
}
/// Idempotency + recovery record for a customer-initiated provider mutation.
model CustomerOperation {
 id String @id @default(uuid())
 customerId String
 kind String
 idempotencyKey String
 /// STARTED | SUCCEEDED | FAILED
 status String @default("STARTED")
 request Json @default("{}")
 result Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([customerId, kind, idempotencyKey])
 @@index([status, createdAt])
}
/// A requested plan change for one subscription. Benefits change only when Stripe confirms.
model SubscriptionChange {
 id String @id @default(uuid())
 subscriptionId String
 subscription Subscription @relation(fields: [subscriptionId], references: [id])
 customerId String
 /// UPGRADE | DOWNGRADE | INTERVAL_CHANGE
 kind String
 /// PENDING_PAYMENT | SCHEDULED | APPLIED | WITHDRAWN | FAILED
 status String
 fromSnapshot Json @default("{}")
 toSnapshot Json @default("{}")
 targetPriceId String?
 stripeScheduleId String?
 stripeInvoiceId String?
 amountDueNow Int @default(0)
 currency String @default("usd")
 effectiveAt DateTime?
 appliedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([subscriptionId, status])
 @@index([customerId])
}
/// Stripe Price created for a catalog/legacy plan so a subscription item can be swapped.
model StripePriceRef {
 id String @id @default(uuid())
 key String @unique
 stripePriceId String
 createdAt DateTime @default(now())
}
/// Customer request that needs staff review: support, refund, reschedule, booking
/// cancellation, account closure, purchase-claim dispute.
model SupportRequest {
 id String @id @default(uuid())
 customerId String
 type String
 subject String
 message String
 reference String?
 status String @default("OPEN")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([customerId, createdAt])
 @@index([status, createdAt])
}
model Order {
 id String @id @default(uuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 status OrderStatus @default(PENDING)
 mode String @default("PAYMENT")
 currency String @default("usd")
 subtotalAmount Int @default(0)
 discountAmount Int @default(0)
 taxAmount Int @default(0)
 totalAmount Int @default(0)
 dueNowAmount Int @default(0)
 recurringAmount Int @default(0)
 recurringInterval BillingInterval?
 couponCode String?
 paymentMethod String @default("STRIPE")
 stripeCheckoutSessionId String? @unique
 stripePaymentIntentId String?
 termsVersion String?
 termsAcceptedAt DateTime?
 /// Contact details as entered at checkout. A snapshot, never an authorization input.
 contactName String?
 contactEmail String?
 contactPhone String?
 notes String?
 metadata Json @default("{}")
 paidAt DateTime?
 expiresAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 items OrderItem[]
 subscriptions Subscription[]
 @@index([customerId, status])
 @@index([status, createdAt])
 @@index([stripePaymentIntentId])
}
model OrderItem {
 id String @id @default(uuid())
 orderId String
 order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
 planId String?
 plan Plan? @relation(fields: [planId], references: [id])
 description String
 quantity Int @default(1)
 unitAmount Int
 amount Int
 billingType BillingType @default(ONE_TIME)
 interval BillingInterval?
 metadata Json @default("{}")
 @@index([orderId])
}
model Subscription {
 id String @id @default(uuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 orderId String?
 order Order? @relation(fields: [orderId], references: [id])
 planId String?
 plan Plan? @relation(fields: [planId], references: [id])
 stripeSubscriptionId String @unique
 stripeCustomerId String
 stripePriceId String?
 stripeItemId String?
 interval BillingInterval @default(MONTH)
 intervalCount Int @default(1)
 currency String @default("usd")
 unitAmount Int @default(0)
 quantity Int @default(1)
 stripeStatus String @default("incomplete")
 accessStatus AccessStatus @default(PENDING)
 currentPeriodStart DateTime?
 currentPeriodEnd DateTime?
 nextInvoiceAt DateTime?
 cancelAtPeriodEnd Boolean @default(false)
 cancellationRequestedAt DateTime?
 cancelAt DateTime?
 endedAt DateTime?
 canceledByType String?
 canceledById String?
 cancelReason String?
 paymentFailedAt DateTime?
 graceEndsAt DateTime?
 latestInvoiceId String?
 latestInvoiceUrl String?
 metadata Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 /// Stripe-side default card and schedule, mirrored for diagnostics.
 defaultPaymentMethodId String?
 stripeScheduleId String?
 pendingUpdate Boolean @default(false)
 invoices Invoice[]
 entitlements EntitlementEntry[]
 events BillingEvent[]
 changes SubscriptionChange[]
 @@index([customerId])
 @@index([stripeStatus])
 @@index([accessStatus])
 @@index([stripeCustomerId])
 @@index([orderId])
}
model Invoice {
 id String @id @default(uuid())
 stripeInvoiceId String @unique
 subscriptionId String?
 subscription Subscription? @relation(fields: [subscriptionId], references: [id])
 customerId String?
 customer Customer? @relation(fields: [customerId], references: [id])
 amountDue Int @default(0)
 amountPaid Int @default(0)
 amountRemaining Int @default(0)
 subtotal Int @default(0)
 total Int @default(0)
 taxAmount Int @default(0)
 discountAmount Int @default(0)
 number String?
 orderId String?
 lines Json @default("[]")
 dueDate DateTime?
 currency String @default("usd")
 status String @default("draft")
 hostedUrl String?
 pdfUrl String?
 periodStart DateTime?
 periodEnd DateTime?
 createdAt DateTime @default(now())
 @@index([subscriptionId])
 @@index([customerId, createdAt])
}
model BillingEvent {
 id String @id @default(uuid())
 subscriptionId String?
 subscription Subscription? @relation(fields: [subscriptionId], references: [id])
 orderId String?
 customerId String?
 actorType String @default("SYSTEM")
 actorId String?
 actorLabel String?
 action String
 fromState String?
 toState String?
 reason String?
 note String?
 stripeRef String?
 data Json @default("{}")
 createdAt DateTime @default(now())
 @@index([subscriptionId])
 @@index([createdAt])
}
model EntitlementEntry {
 id String @id @default(uuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 subscriptionId String?
 subscription Subscription? @relation(fields: [subscriptionId], references: [id])
 kind EntitlementKind
 delta Int
 reason String
 sourceRef String? @unique
 periodStart DateTime?
 periodEnd DateTime?
 createdAt DateTime @default(now())
 @@index([customerId, kind])
}
model WebhookEvent {
 id String @id @default(uuid())
 stripeEventId String @unique
 type String
 status WebhookStatus @default(PENDING)
 attempts Int @default(0)
 error String?
 payload Json @default("{}")
 receivedAt DateTime @default(now())
 processedAt DateTime?
 @@index([status, receivedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic service catalog: admin-managed services, packages, reusable add-ons
// and amenities. Purely additive. Orders and subscriptions keep their own price
// snapshots (OrderItem.unitAmount, Subscription.unitAmount), so editing a price
// here never rewrites a historical financial record or an active billing cycle.
// ─────────────────────────────────────────────────────────────────────────────
enum ServiceBookingFlow {
 STANDARD // 6-step: Service -> Plan -> Amenities -> Extras -> Schedule -> Checkout
 NO_EXTRAS // Skips add-on selection (e.g. Business Address, Mailbox)
 MEMBERSHIP // Skips amenities, add-ons, calendar; routes to Circle selection
 CUSTOM // Admin-defined step array
}
enum BillingIntervalUnit {
 ONE_TIME // Flat one-time charge
 PER_HOUR // Multiplied by selected duration hours (1-24h)
 PER_DAY // Multiplied by day count
 PER_MONTH // Monthly recurring cycle (30 days)
 PER_YEAR // Annual recurring cycle
 PER_SESSION // Billed per appointment session
 PER_ITEM // Multiplied by gear/item quantity
 PER_SETUP // Flat technical staging fee
 PER_BOOKING // Flat booking surcharge
 PER_PODCAST // Media fee per podcast episode
 PER_CLIP // Media fee per highlight clip
 CUSTOM // Custom duration
}
model ServiceCategory {
 id String @id @default(uuid())
 slug String @unique
 name String
 description String @default("")
 categoryBadge String?
 iconName String @default("Layers")
 heroImageUrl String?
 displayOrder Int @default(0)
 active Boolean @default(true)
 flowType ServiceBookingFlow @default(STANDARD)
 customSteps Json @default("[]")
 metadata Json @default("{}")
 archivedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 plans CatalogPlan[]
 serviceAddOns ServiceAddOn[]
 serviceAmenities ServiceAmenity[]
 @@index([active, displayOrder])
}
model CatalogPlan {
 id String @id @default(uuid())
 slug String @unique
 serviceId String
 service ServiceCategory @relation(fields: [serviceId], references: [id], onDelete: Cascade)
 name String
 description String @default("")
 unitAmountCents Int
 currency String @default("usd")
 billingUnit BillingIntervalUnit @default(PER_MONTH)
 durationMinutes Int?
 durationDays Int?
 minQuantity Int @default(1)
 maxQuantity Int @default(1)
 capacityText String?
 capacityMin Int?
 capacityMax Int?
 featured Boolean @default(false)
 active Boolean @default(true)
 archivedAt DateTime?
 sortOrder Int @default(0)
 rulesNotice String?
 governmentNotice String?
 adminFlagNote String?
 metadata Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 planAddOns PlanAddOn[]
 planAmenities PlanAmenity[]
 @@index([serviceId, active, sortOrder])
}
model CatalogAddOn {
 id String @id @default(uuid())
 slug String @unique
 name String
 description String @default("")
 unitAmountCents Int
 currency String @default("usd")
 billingUnit BillingIntervalUnit @default(ONE_TIME)
 minQuantity Int @default(0)
 maxQuantity Int @default(10)
 defaultQuantity Int @default(1)
 imageUrl String?
 active Boolean @default(true)
 archivedAt DateTime?
 adminFlagNote String?
 metadata Json @default("{}")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 serviceAddOns ServiceAddOn[]
 planAddOns PlanAddOn[]
 @@index([active])
}
model ServiceAddOn {
 serviceId String
 service ServiceCategory @relation(fields: [serviceId], references: [id], onDelete: Cascade)
 addOnId String
 addOn CatalogAddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)
 priceOverrideCents Int?
 isRequired Boolean @default(false)
 sortOrder Int @default(0)
 @@id([serviceId, addOnId])
 @@index([addOnId])
}
model PlanAddOn {
 planId String
 plan CatalogPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
 addOnId String
 addOn CatalogAddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)
 priceOverrideCents Int?
 isRequired Boolean @default(false)
 sortOrder Int @default(0)
 @@id([planId, addOnId])
 @@index([addOnId])
}
model CatalogAmenity {
 id String @id @default(uuid())
 slug String @unique
 name String
 description String @default("")
 iconUrl String?
 iconName String @default("Check")
 active Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 serviceAmenities ServiceAmenity[]
 planAmenities PlanAmenity[]
 @@index([active])
}
model ServiceAmenity {
 serviceId String
 service ServiceCategory @relation(fields: [serviceId], references: [id], onDelete: Cascade)
 amenityId String
 amenity CatalogAmenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
 sortOrder Int @default(0)
 @@id([serviceId, amenityId])
 @@index([amenityId])
}
model PlanAmenity {
 planId String
 plan CatalogPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
 amenityId String
 amenity CatalogAmenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
 sortOrder Int @default(0)
 @@id([planId, amenityId])
 @@index([amenityId])
}
