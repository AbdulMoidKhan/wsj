DATABASE_URL=postgresql://wsj:CHANGE_ME@localhost:5437/wsj?schema=public
POSTGRES_USER=wsj
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wsj
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_12_PLUS_CHARACTER_PASSWORD
PORT=4000
FRONTEND_URL=http://localhost:3000
API_ORIGIN=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_TO=

# Optional comma-separated explicit browser origins. No wildcards.
FRONTEND_URLS=

# Stripe payments. See PAYMENTS_SETUP.md for full setup.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Customer accounts (see CUSTOMER_ACCOUNT_IMPLEMENTATION_REPORT.md).
# Transactional email (account setup, sign-in links, receipts) is delivered from the
# EmailOutbox through SMTP_* above. Without SMTP the outbox keeps messages PENDING
# and nothing is reported as sent.
# Local development only: write outgoing mail to files in this directory instead
# of the network. Ignored when NODE_ENV=production.
MAIL_CAPTURE_DIR=
# Set to "off" to disable the in-process outbox worker (e.g. on all but one instance).
OUTBOX_WORKER=

# Cloudflare R2 object storage (src/storage.ts). Values live only in the real .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional when R2_ACCOUNT_ID is set: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL for objects (r2.dev development URL or a custom domain), no trailing slash
R2_PUBLIC_URL=
R2_REGION=auto
