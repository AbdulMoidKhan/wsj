# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/backend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production builds
/.next/
/out/
/build
/dist
/backend/dist
# scratch/experimental Next build dirs
/.next-qa/
/.next-prod/
/.next-classic/
/.next-redesign/
/.next-billing-build/

# Testing / coverage
/coverage
/test-results/
/playwright-report/

# Environment files and secrets
.env
.env.*
!.env.example
/backend/.env
/backend/.env.*
!/backend/.env.example
*.pem
*.key

# Temporary artifacts and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Generated QA / capture artifacts
/screenshots/
/screenshot/
/lighthouse/
/.continuation.lock
/.continuation-heartbeat.json

# Agent / editor scratch
/.claude/worktrees/
/.agents/tmp/

# Deploy targets
.vercel

# Agent prompt scratch (kept locally, not versioned)
/CLEAN_DEPLOY_MASTER_PROMPT.md
/FULL_QA_TEST_PROMPT.md
/GSAP_SCROLL_MOTION_PROMPT.md
/MOTION_DESIGN_PROMPT.md
